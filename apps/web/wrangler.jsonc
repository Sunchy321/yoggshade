// 纯静态部署（ADR-0002，2026-10-09 裁定：渲染链跑在用户浏览器，无 Worker 计算面）。
// dist/ = vite 前端产物 + pack/**（资产树，含 TTF 与 freetype.wasm）+ data/**（冻结数据），
// 由 scripts/build-worker.ts 组装；浏览器端直接取 /pack/**、/data/** 渲染。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yoggraph-cards",
  "routes": [
    { "pattern": "hsdiy.tcg.cards", "custom_domain": true }
  ],
  "assets": {
    "directory": "dist"
  }
}
