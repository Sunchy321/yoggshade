// Cloudflare Workers 配置（ticket 10/14）：
// - main: src/worker.ts（/api/* 进程内渲染；AssetSource = ASSETS 绑定预取）
// - assets.directory: dist/（vite build 产物 + pack/** 数据拷贝，scripts/build-worker.ts 组装）
// - run_worker_first: /api/* 先进 Worker，其余直接走静态资产（免费、不限量）
// - nodejs_compat: node:zlib（PNG 解码 inflateSync）需要
// 部署口径：渲染 CPU 0.5-1.5 s/卡 → 免费 plan 的 10ms CPU 上限不可用，**必须 Workers Paid
// （$5/月，CPU 默认 30 s）**——与 Containers 路线同一付费门槛（ticket 14 报价留档）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yoggraph-cards",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "RENDER_LIMIT": "12" },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
